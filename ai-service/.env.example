OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
CLIENT_ORIGIN=http://localhost:5173
SERVER_ORIGIN=http://localhost:5000

# Shared secret the Express server must send as `Authorization: Bearer <token>` on every
# request. Must match AI_SERVICE_TOKEN in server/.env. Requests fail closed (401) if unset.
AI_SERVICE_TOKEN=change-me
