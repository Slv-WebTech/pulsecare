PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://user:password@localhost:5432/healthcare

JWT_SECRET=change-me
# Access-token lifetime. Kept short: the client renews it from an httpOnly refresh cookie (7 days,
# rotating, revocable server-side).
JWT_EXPIRES_IN=15m

# NODE_ENV=production makes the refresh cookie `Secure` (HTTPS only).
# NODE_ENV=production

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default IANA timezone for doctors who have not set their own (doctor_profiles.timezone).
# Availability windows are wall-clock times in the doctor's timezone (DST-aware).
# Unset = the server machine's local timezone.
# DEFAULT_TIMEZONE=Asia/Kolkata

# Max upcoming (scheduled/confirmed) appointments one patient may hold.
# MAX_ACTIVE_APPOINTMENTS=10

# Rate limits (requests per window, per IP). Defaults shown.
# AUTH_RATE_LIMIT=20      # login/register, per 15 min
# REFRESH_RATE_LIMIT=120  # token refresh, per 15 min
# API_RATE_LIMIT=300      # whole /api, per minute

AI_SERVICE_URL=http://localhost:8000
# Must match AI_SERVICE_TOKEN in ai-service/.env — sent as a bearer token on every call to ai-service.
AI_SERVICE_TOKEN=change-me
